{
	"name": "companion-module-cuedeck",
	"version": "0.1.3",
	"description": "Bitfocus Companion module for CueDeck — presentation operator tool for live events",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"package": "npm run build && companion-module-build",
		"check": "companion-module-check",
		"lint": "eslint .",
		"format": "prettier -w ."
	},
	"license": "MIT",
	"author": "Azat Khusaenov",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ttpa3dhuk/CueDeck.git"
	},
	"engines": {
		"node": "^22.20"
	},
	"dependencies": {
		"@companion-module/base": "2.0.4"
	},
	"devDependencies": {
		"@companion-module/tools": "3.1.0",
		"@types/node": "^22.19.17",
		"eslint": "^9.39.4",
		"prettier": "^3.8.3",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.59.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json"
}
