{
  "name": "cue-deck",
  "version": "0.14.2",
  "description": "Presentation operator tool for live events — speaker playlist, per-speaker timers, confidence monitor, blackout",
  "author": "Azat Khusaenov",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/stop-dev.cjs && node scripts/fetch-omt.cjs && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "companion:build": "vite-node companion/build.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:release-qa": "python3 -m unittest discover -s scripts/release-qa -p 'test_*.py'",
    "prepare:ffprobe": "node scripts/prepare-ffprobe.cjs --target=all",
    "verify:ffprobe": "node scripts/prepare-ffprobe.cjs --verify-only --target=all",
    "package:mac": "node scripts/prepare-syphon.cjs && node scripts/prepare-ffprobe.cjs --target=darwin-arm64,darwin-x64 && node scripts/fetch-omt.cjs --strict && electron-vite build && electron-builder --mac --publish=never && node scripts/rename-mac.cjs",
    "package:win": "node scripts/prepare-ffprobe.cjs --target=win32-x64 && node scripts/fetch-omt.cjs --strict && electron-vite build && electron-builder --win --config.electronVersion=44.7.2 --publish=never",
    "package:all": "npm run package:mac && npm run package:win",
    "fetch:omt": "node scripts/fetch-omt.cjs",
    "prepare:spout": "node scripts/prepare-spout.cjs",
    "prepare:syphon": "node scripts/prepare-syphon.cjs",
    "verify:syphon": "node scripts/prepare-syphon.cjs --verify-only",
    "test:syphon-build": "node --test tests/prepare-syphon.test.cjs",
    "verify:spout": "node scripts/prepare-spout.cjs --verify-only",
    "test:spout-build": "node --test tests/prepare-spout.test.cjs tests/verify-spout-package.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "electron": "44.7.2",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-store": "^10.0.1",
    "koffi": "^2.16.3",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4"
  },
  "build": {
    "beforePack": "scripts/verify-native-package.cjs",
    "appId": "com.azat.cue-deck",
    "productName": "CueDeck",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!**/node_modules/koffi/{src,vendor,lib,doc}/**",
      "!**/node_modules/koffi/build/koffi/{freebsd*,linux*,musl*,openbsd*,win32_ia32,win32_arm64}/**"
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "extendInfo": {
        "NSCameraUsageDescription": "CueDeck takes video from a USB capture device or camera to show an external source (the host's or DJ's laptop) on the audience screen.",
        "NSMicrophoneUsageDescription": "CueDeck takes audio from the capture device's input when sound arrives together with the picture over HDMI."
      },
      "extraResources": [
        {
          "from": "native/syphon-probe/build/darwin-${arch}/libcuedeck_syphon_gpu.dylib",
          "to": "syphon/libcuedeck_syphon_gpu.dylib"
        },
        {
          "from": "native/syphon-probe/build/darwin-${arch}/Syphon.framework",
          "to": "syphon/Syphon.framework"
        },
        {
          "from": "vendor/ffprobe/${os}-${arch}",
          "to": "ffprobe"
        },
        {
          "from": "build/ru.lproj",
          "to": "ru.lproj"
        },
        {
          "from": "vendor/omt/mac",
          "to": "omt"
        }
      ],
      "binaries": [
        "Contents/Resources/ffprobe/ffprobe",
        "Contents/Resources/syphon/libcuedeck_syphon_gpu.dylib",
        "Contents/Resources/syphon/Syphon.framework/Versions/A/Syphon"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "native/spout-sender/build/cuedeck_spout_gpu.dll",
          "to": "spout/cuedeck_spout_gpu.dll"
        },
        {
          "from": "native/spout-receiver/third-party-notes/SPOUT2-LICENSE.txt",
          "to": "spout/Spout2-LICENSE.txt"
        },
        {
          "from": "vendor/ffprobe/${os}-${arch}",
          "to": "ffprobe"
        },
        {
          "from": "vendor/omt/win",
          "to": "omt"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CueDeck-${version}-Setup.${ext}",
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ],
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "asar": true,
    "compression": "normal",
    "asarUnpack": [
      "**/node_modules/koffi/build/**"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
